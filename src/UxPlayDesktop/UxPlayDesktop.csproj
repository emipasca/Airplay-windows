<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\resources\newicon.ico</ApplicationIcon>
    <AssemblyName>AirPlayDesktop</AssemblyName>
    <Product>AirPlay Desktop</Product>
    <AssemblyTitle>AirPlay Desktop</AssemblyTitle>
    <Description>AirPlay receiver for Windows (based on jorjanion/uxplay-desktop and FDH2/UxPlay, GPL-3.0)</Description>
    <Version>1.2.5</Version>
    <AssemblyVersion>1.2.5.0</AssemblyVersion>
    <FileVersion>1.2.5.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\resources\newicon.ico" Link="resources\newicon.ico" />
    <None Include="..\..\resources\newicon.ico" Link="resources\newicon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="8.0.1" />
  </ItemGroup>

</Project>
